# Landing page (this app) runs on port 3002.
# NEXTAUTH_URL points to the Dashboard app — where NextAuth actually lives.
# When the landing page calls useSession() it will fetch /api/auth/session
# from this URL, so the NextAuth cookie has to be set by the dashboard.
NEXTAUTH_URL=http://localhost:3001

# Public dashboard API URL — used by the landing page to fetch /api/config
# and /api/public/booking/* (services, stylists, slots, POST booking).
NEXT_PUBLIC_API_URL=http://localhost:3001

# Public landing-page URL — used for redirects and absolute links.
NEXT_PUBLIC_LANDING_URL=http://localhost:3002

# NextAuth secret — must match the dashboard's NEXTAUTH_SECRET so the
# JWT issued by the dashboard is valid when read by the landing page.
# In dev you can set any long string. Keep it consistent across apps.
NEXTAUTH_SECRET=glamchain-dev-secret-change-me-in-production
